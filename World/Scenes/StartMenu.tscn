[node name="Control map" type="Label" parent="StartMenu/MarginContainer/LeftMenu/HBoxContainer/Controls" unique_id=498662116]
custom_minimum_size = Vector2(45.725, 130.52)
layout_mode = 2
theme = ExtResource("7_kh32d")
text = "interaction - 
	LMB: pick up
	RMB: use
	Scroll: select held item
	Q & E: rotate held item
	G: drop held item
on ground - 
	Space: jump
	hold Space: hover
while hovering - 
	Space: increase height
	Ctrl: decrease height
	double tap Space: begin flight
while flying - 
	W - pitch down
	S - pitch up
	Space - strong flap
	hold Space - constant flap
	Ctrl - slow down
hold Alt  -  disable auto camera
hold Tab -  show nest markers
F     -  toggle HUD"
tab_stops = PackedFloat32Array(60)

